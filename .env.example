# Copy this file to .env and fill in real values. Never commit .env.
# This example file is committed so a new developer can see which variables exist.

JWT_SECRET=change-me
TOKEN_EXPIRE_MINUTES=60

LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512

# Each service connects as its own Postgres role to its own database
DATABASE_URL=postgresql+psycopg://ledger_core:change-me@localhost:5432/ledger_core
ASSISTANT_DATABASE_URL=postgresql+psycopg://assistant:change-me@localhost:5432/assistant

POSTGRES_ADMIN_PASSWORD=change-me
LEDGER_CORE_DB_PASSWORD=change-me
ASSISTANT_DB_PASSWORD=change-me
